# Copy to .env for local dev (never commit the real .env).
# In production these are set as environment variables on Render / GitHub Actions.

# Neon serverless Postgres. Use the POOLED connection string (host contains
# "-pooler") so connections go through PgBouncer — required with NullPool in db.py.
# Example: postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
DATABASE_URL=

# Alpha Vantage key for daily_update.py (TIME_SERIES_DAILY / HISTORICAL_OPTIONS / TREASURY_YIELD).
ALPHA_VANTAGE_API_KEY=

# databento API key for OrderFlowCanyon live order-book data (paid).
# Read by OrderFlowCanyon/data.py via os.getenv("API_KEY").
API_KEY=
